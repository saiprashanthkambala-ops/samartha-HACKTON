# FarmShield frontend — public environment variables
#
# NEVER put secrets here (database strings, AI provider keys, weather API keys,
# private auth credentials). Anything prefixed with VITE_ is shipped to the
# browser and is PUBLIC.

# Base URL of the FarmShield backend API (friend's backend service).
# Leave empty to run the frontend in clearly-labelled DEMO mode.
# Example: VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=

# Optional: proxy same-origin /api requests during `npm run dev` to a local
# backend (avoids CORS while developing). Consumed by vite.config.js.
# Example: VITE_API_PROXY_TARGET=http://localhost:8000
# VITE_API_PROXY_TARGET=
